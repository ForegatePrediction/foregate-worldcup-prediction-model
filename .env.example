# x402 v2 / OKX Agent Payments Protocol settings (X Layer · eip155:196).
# Copy into your host's Environment (e.g. Render → Environment). Default is FREE (paywall off).

PAYWALL_ENABLED=false

# Network & price — 0.01 USD = 10000 minimal units (6-decimals stablecoin)
PAY_NETWORK=eip155:196
PAY_AMOUNT=10000

# Receiving address (402 challenge payTo) — your Agentic Wallet
PAY_TO_ADDRESS=0xb7338d8e84571de0d032b5fd47f31917523d0e6f

# Stablecoin on X Layer. Default in code = USD₮0 (USDT). To use USDG instead, set both:
#   PAY_ASSET_CONTRACT=0x4ae46a509f6b1d9056937ba4500cb143933d2dc8
#   PAY_EIP712_NAME=Global Dollar
PAY_ASSET_CONTRACT=0x779ded0c9e1022225f8e0630b35a9b54be713736
PAY_EIP712_NAME=USD₮0
PAY_EIP712_VERSION=2

# OKX facilitator. facilitatorAddress is fetched dynamically from /supported; override only if needed.
OKX_X402_BASE=https://web3.okx.com/api/v6/pay/x402
OKX_FACILITATOR_ADDRESS=
# OKX API auth for /supported,/verify,/settle. If your account uses key/secret/passphrase HMAC or the
# OKXFacilitatorClient SDK, wire that in api/x402.mjs okxHeaders(); OKX_API_KEY alone is a placeholder.
OKX_API_KEY=

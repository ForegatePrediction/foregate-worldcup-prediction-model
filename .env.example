# x402 v2 / OKX Agent Payments Protocol settings for the A2MCP service.
# Copy the relevant values into your host's Environment settings (e.g. Render → Environment).
# Leave PAYWALL_ENABLED=false to keep the endpoint free (default).

# Turn the paywall on/off
PAYWALL_ENABLED=false

# Network & price (X Layer mainnet; 0.01 of a 6-decimals stablecoin = 10000 minimal units)
PAY_NETWORK=eip155:196
PAY_AMOUNT=10000

# Your Agentic Wallet receiving address (the 402 challenge `payTo`) — already known:
PAY_TO_ADDRESS=0xb7338d8e84571de0d032b5fd47f31917523d0e6f

# --- Values OKX must confirm before going paid ---
PAY_ASSET_CONTRACT=          # USDT or USDG token contract on X Layer
PAY_EIP712_NAME=             # token EIP-712 domain name
PAY_EIP712_VERSION=1
OKX_FACILITATOR_ADDRESS=     # for the "upto" scheme (extra.facilitatorAddress)
X402_UPTO_PROXY=             # x402 upto proxy / spender address (informational)
OKX_FACILITATOR_URL=         # facilitator verify/settle service, if OKX provides an HTTP one
OKX_FACILITATOR_KEY=         # if the facilitator issues a key

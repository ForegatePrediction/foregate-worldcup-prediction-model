# x402 pay-per-call settings for the A2MCP service.
# Copy the relevant values into your host's Environment settings (e.g. Render → Environment).
# Leave PAYWALL_ENABLED unset/false to keep the endpoint free.

# Turn the paywall on/off
PAYWALL_ENABLED=false

# Pricing (intro / funnel price)
PRICE_USDG=0.01
PAY_ASSET=USDG
PAY_NETWORK=x-layer

# Your Agentic Wallet receiving address (paste from Onchain OS — NOT a private key)
PAY_TO_ADDRESS=

# OKX Payment facilitator (from the OKX Payment SDK docs once you have access)
OKX_FACILITATOR_URL=
OKX_FACILITATOR_KEY=
